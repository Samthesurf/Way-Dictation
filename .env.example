# Get a free key at https://console.groq.com/keys (free tier, no card required)
# Then copy this file to .env and fill in your key.
GROQ_API_KEY=

# Optional: use OpenRouter for transcription instead of Groq.
# - gpt-transcribe: dedicated STT, more accurate, paid (~$0.0045/min)
# - gemini: general LLM that understands audio (slower, hallucinates over silence)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional: override the transcription model (default is free whisper-large-v3-turbo)
# GROQ_MODEL=whisper-large-v3-turbo

# Optional: force a specific language (ISO-639-1), e.g. en, es, fr
# DICTATION_LANG=en
